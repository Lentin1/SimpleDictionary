{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "简辞",
  "version": "0.2.0",
  "identifier": "com.vocabflow.jianci",
  "build": {
    "beforeDevCommand": "npm run v2:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run v2:build",
    "frontendDist": "../v2/dist"
  },
  "app": {
    "windows": [
      {
        "title": "简辞 · 按章节背单词",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "category": "Education",
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
